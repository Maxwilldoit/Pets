{
  "$schema": "../../schema/pet.schema.json",
  "id": "shuangyan-crate-duo",
  "name": "双烟二人组",
  "description": "坐在啤酒箱上抽烟的两个人。坐着不走动，拖动时有专门的动画。",
  "version": "1.0.0",
  "tags": ["Q版", "双人", "Codex"],
  "scale": 0.9,
  "behavior": {"click": "waving", "doubleClick": "jumping"},
  "animations": {
    "idle": {"src": "gifs/shuangyan-crate-duo-idle.gif"},
    "drag-right": {"src": "gifs/shuangyan-crate-duo-running-right.gif"},
    "drag-left": {"src": "gifs/shuangyan-crate-duo-running-left.gif"},
    "waving": {"src": "gifs/shuangyan-crate-duo-waving.gif", "label": "挥手", "repeat": 2},
    "jumping": {"src": "gifs/shuangyan-crate-duo-jumping.gif", "label": "跳一跳"},
    "running": {"src": "gifs/shuangyan-crate-duo-running.gif", "label": "忙碌中", "repeat": 3},
    "waiting": {"src": "gifs/shuangyan-crate-duo-waiting.gif", "label": "等待中", "repeat": 3},
    "review": {"src": "gifs/shuangyan-crate-duo-review.gif", "label": "审阅", "repeat": 3},
    "failed": {"src": "gifs/shuangyan-crate-duo-failed.gif", "label": "失败了", "repeat": 2, "weight": 0.3}
  }
}
